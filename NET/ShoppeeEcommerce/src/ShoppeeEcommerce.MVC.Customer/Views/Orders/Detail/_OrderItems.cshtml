@using ShoppeeEcommerce.MVC.Customer.ViewModels.Orders
@model OrderDetailViewModel

<div class="card bg-base-100 shadow">
    <div class="card-body">
        <h3 class="font-bold text-lg mb-4">Items</h3>

        <div class="space-y-4">
            @foreach (var item in Model.Order.Items)
            {
                <div class="flex gap-4 border-b pb-4">

                    <img src="@(item.ProductImgUrl ?? "/images/no-image.png")"
                         class="w-20 h-20 object-cover rounded" />

                    <div class="flex-1">
                        <div class="font-semibold">@item.ProductName</div>
                        <div class="text-sm opacity-70">SKU: @item.ProductSKU</div>
                        <div class="text-sm">Qty: @item.Quantity</div>
                    </div>

                    <div class="text-right">
                        <div>$@item.Price</div>
                        <div class="font-semibold">
                            $@(item.Price * item.Quantity)
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>
</div>
