@model Guid

<input type="checkbox" id="cancel-order-modal" class="modal-toggle" checked />

<div class="modal">
    <div class="modal-box">
        <h3 class="text-lg font-bold">Cancel this order?</h3>
        <p class="py-4">This action cannot be undone.</p>

        <div class="modal-action">
            <label for="cancel-order-modal" class="btn">Close</label>

            <button class="btn btn-error"
                    hx-patch="/orders/cancel/@Model"
                    hx-target="#order-header"
                    hx-swap="outerHTML">
                Yes, cancel it
            </button>
        </div>
    </div>
</div>
