@using ShoppeeEcommerce.MVC.Customer.ViewModels.Orders
@model UserOrdersViewModel

<div class="flex justify-center mt-6 gap-2">

    @for (int i = 1; i <= Model.Orders.TotalPages; i++)
    {
        <button class="btn btn-sm @(i == Model.Orders.PageNumber ? "btn-primary" : "btn-ghost")"
                hx-get="/orders/index?pageIndex=@i"
                hx-include="#orders-filter-form"
                hx-swap="innerHTML"
                hx-target="#orders-container"
                hx-push-url="true">
            @i
        </button>
    }

</div>
