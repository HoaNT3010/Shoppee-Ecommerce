@using ShoppeeEcommerce.SharedViewModels.Models.Orders.ListUserOrders
@model UserOrderSummary

<div class="card bg-base-100 shadow border hover:border-primary">
    <div class="card-body flex flex-row gap-4 items-center">

        <div class="flex-1">
            <div class="flex justify-between">

                <h2 class="font-semibold">
                    Order #@Model.Id.ToString().Substring(0, 8)
                </h2>
                
            </div>

            <div class="badge badge-outline my-2">@Model.Status</div>

            <div class="text-sm opacity-70">
                @Model.CreatedDate.ToString("dd MMM yyyy HH:mm") - @Model.LineItemsCount item(s)
            </div>

        </div>

        <div class="text-right">
            <div class="font-bold text-primary text-lg">
                $@Model.TotalPrice
            </div>

            <a class="btn btn-sm btn-outline mt-2 hover:btn-primary"
                   href="/orders/@Model.Id">
                View detail
            </a>
        </div>

    </div>
</div>
