@using ShoppeeEcommerce.MVC.Customer.ViewModels.Cart
@model CheckoutPaymentMethodVM

<div class="card bg-base-100 shadow">
    <div class="card-body">
        <h2 class="card-title">Payment Method</h2>

        <fieldset class="fieldset">
            <legend class="fieldset-legend">Payment Method</legend>
            <select disabled class="select w-full">
                <option disabled>Pick a payment method</option>
                <option>Cash</option>
                <option selected>Online</option>
            </select>
            <p class="text-sm opacity-70">Currently only support online payment with Stripe.</p>
        </fieldset>

    </div>
</div>
