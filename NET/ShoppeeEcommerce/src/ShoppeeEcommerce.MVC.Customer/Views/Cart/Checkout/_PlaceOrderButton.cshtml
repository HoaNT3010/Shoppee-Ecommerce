@using ShoppeeEcommerce.MVC.Customer.ViewModels.Cart
@model CheckoutViewModel

<button class="btn btn-primary w-full mt-4"
        hx-post="/cart/checkout/place"
        hx-swap="none"
        disabled="@(Model.Cart.HasInactiveItem || Model.Cart.Items.Count == 0 ? "disabled" : null)">
    Place Order
</button>