@using ShoppeeEcommerce.MVC.Customer.ViewModels.Cart
@model CheckoutViewModel

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <div class="lg:col-span-2 space-y-6">
        <partial name="Checkout/_ShippingAddress" model="Model.Address" />
        <partial name="Checkout/_PaymentMethod" model="Model.Payment" />
    </div>

    <div>
        <partial name="Checkout/_OrderSummary" model="Model.Cart" />
        <partial name="Checkout/_PlaceOrderButton" model="Model" />
    </div>

</div>
