@using ShoppeeEcommerce.SharedViewModels.Models.Carts.View
@model List<ViewCartItemResponse>

<div class="space-y-4">
    @if (Model.Count == 0)
    {
        <div class="flex flex-col items-center justify-center py-24 text-center gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-base-content/20" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-1.5 6h13M7 13L5.4 5M10 21a1 1 0 1 0 2 0
                1 1 0 0 0-2 0zm7 0a1 1 0 1 0 2 0 1 1 0 0 0-2 0z" />
            </svg>
            <div>
                <p class="font-semibold text-lg">Empty cart!</p>
                <p class="text-sm text-base-content/50 mt-1">
                    Try adding more products to your cart.
                </p>
            </div>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <partial name="_CartItemRow" model="item" />
        }
    }
</div>
