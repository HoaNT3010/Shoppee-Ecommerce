@using ShoppeeEcommerce.MVC.Customer.ViewModels.Home
@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="max-w-7xl mx-auto px-4 py-8">

    <!-- Hero -->
    <partial name="Home/_HeroSection" />

    <!-- Featured -->
    <partial name="Products/_ProductSection"
             model="Model.FeaturedProducts"
             view-data='new ViewDataDictionary(ViewData) { ["Title"] = "Featured Products" }' />

    <!-- Newest -->
    <partial name="Products/_ProductSection"
             model="Model.NewestProducts"
             view-data='new ViewDataDictionary(ViewData) { ["Title"] = "Newest Products" }' />

</div>
