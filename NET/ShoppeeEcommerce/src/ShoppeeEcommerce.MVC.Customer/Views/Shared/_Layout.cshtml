<!DOCTYPE html>
<html lang="en" data-theme="emerald">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shoppee</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-neutral-content">
    <header>
        <partial name="Navbar/_Navbar" />
    </header>

    <div id="toast-container" class="toast toast-top toast-end z-50">
        @if (TempData["ToastMessage"] is string message)
        {
            var type = TempData["ToastType"]?.ToString() ?? "info";
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    renderToast("@message", "@type");
                });
            </script>
        }
    </div>

    <main class="container mx-auto px-4 py-8">
        @RenderBody()
    </main>

    <!-- The Footer Component -->
    <partial name="Footer/_Footer" />

    <!-- HTMX -->
    <script src="~/js/htmx.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<script>
    function renderToast(message, type) {
        console.log("Rendering toast");
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = 'alert shadow-lg mb-2 alert-' + type;
        toast.innerHTML = `<span>${message}</span>`;

        container.appendChild(toast);

        setTimeout(() => {
            console.log("Toast dissappearing...")
            toast.remove();
        }, 3000);
    }

    document.body.addEventListener('showToast', function (evt) {
        const { message, type } = evt.detail;
        renderToast(message, type);
    });
</script>
