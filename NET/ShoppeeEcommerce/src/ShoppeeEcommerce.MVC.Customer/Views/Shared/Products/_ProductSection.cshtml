@using ShoppeeEcommerce.SharedViewModels.Models.Products
@model IEnumerable<BaseProductSummaryResponse>

@{
    var title = ViewData["Title"]?.ToString();
    var sliderId = "slider-" + Guid.NewGuid().ToString("N");
    var featured = ViewData["Featured"]?.ToString();
    var newest = ViewData["Newest"]?.ToString();
    var sortBy = newest != null ? "createdDate" : "";
    var sortDesc = newest != null ? "true" : "";
}

<section class="mt-14">
    <!-- Title -->
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold">@title</h2>
        <a asp-controller="Products"
               asp-action="Index"
               asp-route-isFeatured="@featured"
               asp-route-sortBy="@sortBy"
               asp-route-sortDesc="@sortDesc"
               class="link link-primary">
            View all
        </a>
    </div>

    <partial name="Products/_ProductSlider" model="Model" />

</section>
