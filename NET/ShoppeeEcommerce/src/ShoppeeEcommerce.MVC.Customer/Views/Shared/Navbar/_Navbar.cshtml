<div class="navbar bg-base-100 shadow-md sticky top-0 z-50 px-4 md:px-10">

    <!-- LEFT: Brand -->
    <div class="navbar-start">
        <partial name="Navbar/_NavbarBrand" />
    </div>

    <!-- CENTER: Categories + Search (desktop) -->
    <div class="navbar-center hidden lg:flex items-center gap-6 max-3w-xl">
        @await Component.InvokeAsync("CategoriesMenu")

        <div class="flex-1">
            <partial name="Navbar/_NavbarSearch" />
        </div>
        
    </div>

    <!-- RIGHT: Cart + Auth -->
    <div class="navbar-end gap-2">

        <partial name="Navbar/_CartButton" />
        <partial name="Navbar/_AuthSection" />

        <!-- Mobile menu button -->
        <div class="dropdown lg:hidden">
            <label tabindex="0" class="btn btn-ghost btn-circle">
                ☰
            </label>
            <div tabindex="0"
                 class="dropdown-content mt-3 p-4 shadow bg-base-100 rounded-box w-72 right-0">

                <!-- Search (mobile) -->
                <div class="mb-4">
                    <partial name="Navbar/_NavbarSearch" />
                </div>

                <!-- Categories (mobile) -->
                <div class="mb-4">
                    @await Component.InvokeAsync("CategoriesMenu")
                </div>
            </div>
        </div>

    </div>
</div>
