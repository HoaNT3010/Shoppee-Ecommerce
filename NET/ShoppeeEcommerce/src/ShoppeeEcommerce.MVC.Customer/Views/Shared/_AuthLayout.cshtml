<!DOCTYPE html>
<html lang="en" data-theme="emerald">
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shoppee</title>
</head>
<body class="bg-neutral-content">

    @if (TempData["ToastMessage"] is string message)
    {
        var type = TempData["ToastType"]?.ToString() ?? "info";
        <div class="toast toast-end toast-end z-50">
            <div class="alert alert-@type shadow-lg">
                <span>@message</span>
            </div>
        </div>

        <script>
                setTimeout(() => {
                    document.querySelector('.toast')?.remove();
                }, 3000);
        </script>
    }

    @RenderBody()

    <script src="~/js/htmx.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>