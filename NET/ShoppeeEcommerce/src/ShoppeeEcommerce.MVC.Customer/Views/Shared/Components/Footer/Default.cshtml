@using ShoppeeEcommerce.SharedViewModels.Models.Categories
@model List<BaseCategoryResponse>

<footer class="footer sm:footer-horizontal p-10 bg-base-100 px-4 md:px-10">
    <nav>
        <h6 class="footer-title">Categories</h6>
        @foreach (var category in Model)
        {
            <a class="link link-hover">@category.Name</a>
        }
    </nav>
    <nav>
        <h6 class="footer-title">Support</h6>
        <a asp-controller="Home" asp-action="Contact" class="link link-hover">Contact</a>
        <a class="link link-hover">Shipping Policy</a>
        <a class="link link-hover">FAQs</a>
    </nav>
</footer>
<footer class="footer sm:footer-horizontal footer-center bg-primary p-4">
    <aside>
        <p>© @DateTime.Now.Year - Shoppee Ecommerce</p>
    </aside>
</footer>
